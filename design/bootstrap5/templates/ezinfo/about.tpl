{* DO NOT EDIT THIS FILE! *}

<div class="card mb-3">
<div class="card-body">
    <h1>{'Exponential information: %version'|i18n('design/bootstrap5/ezinfo/about',,hash( '%version', $ezinfo ) )|wash}</h1>

    <h2>Exponential</h2>

    <h3>{'What is Exponential?'|i18n( 'design/bootstrap5/ezinfo/about' )}</h3>

    {if is_set( $what_is_ez_publish )}
       <p>{$what_is_ez_publish}</p>
    {/if}

    <h3>{'Licence'|i18n( 'design/bootstrap5/ezinfo/about' )}</h3>

    {if is_set( $license )}
        <p class="mb-4 overflow-scroll" style="height: 200px;">{$license|explode('\n')|implode('<br>')}</p>
    {/if}
</div>
</div>

{if and( is_set( $contributors ), is_array( $contributors ), count( $contributors )|ge( 1 ) )}
<div class="card mb-3">
    <div class="card-header">
        <h3 class="mb-0">{'Contributors'|i18n( 'design/bootstrap5/ezinfo/about' )}</h3>
    </div>
    <div class="card-body">
        <p>
            The following is a list of <a href="https://exponential.earth">Exponential</a> contributors who have licensed their work for use by <a href="http://ez.no/">eZ Systems AS</a> under the terms and conditions of
            the eZ Systems Contributor Licensing Agreement. As permitted by this agreement with the contributors, <a href="https://se7enx.com/">7x</a> is redistributing the
            contribution under the same license as the file that the contribution is included in. The list of contributors includes the contributors&apos;s
            name, optional contact info and a list of files that they have either contributed or contributed work to.
        </p>

        <ul class="list-unstyled">
            {foreach $contributors as $contributor}
                 <li>{$contributor['name']|wash} : {$contributor['files']|wash}</li>
            {/foreach}
        </ul>
    </div>
</div>
{/if}

<div class="mb-3">
    <h3>{'Copyright Notice'|i18n( 'design/bootstrap5/ezinfo/about' )}</h3>

    <p>
        Copyright &copy; 1998-2026 <a href="https://se7enx.com">7x</a>, with portions copyright by other parties.
    </p>
    <p>
        Copyright &copy; 1999-2014 <a href="http://ez.no/">eZ Systems AS</a>, with portions copyright by other parties.
    </p>
    <p>
        A complete list of all contributors and third-party software follows.
    </p>
</div>

{if and( is_set( $third_party_software ), is_array( $third_party_software ), count( $third_party_software )|ge( 1 ) )}
<div class="card mb-3">
    <div class="card-header">
        <h2 class="mb-0">{'Third-Party Software'|i18n('design/bootstrap5/ezinfo/about')}</h2>
    </div>
    <div class="card-body">
        <p>
            The following is a list of the third-party software that is distributed with this copy of <a href="https://exponential.earth">Exponential</a>. The list of third party
            software includes the license for the software in question and the directory or files that contain the third-party software.
        </p>

        <ul class="list-unstyled">
            {foreach $third_party_software as $software_key => $software}
                <li>{$software|wash}</li>
            {/foreach}
        </ul>
    </div>
</div>
{/if}

<div class="card mb-3">
    <div class="card-header">
        <h2 class="mb-0">{'Extensions'|i18n('design/bootstrap5/ezinfo/about')}</h2>
    </div>
    <div class="card-body">
        <p>The following is a list of the extensions that have been loaded at run-time by this copy of <a href="https://exponential.earth">Exponential</a>.</p>
        {if is_set( $extensions )}
            {foreach $extensions as $ext_name => $extension}
                {if is_array( $extension )}
                    <ul class="list-unstyled">
                        <li>
                            {foreach $extension as $ext_key => $ext_info}
                                {$ext_key|wash}:
                                {if not( is_array( $ext_info ) )}
                                    {$ext_info}<br />
                                {else}
                                    <ul class="list-unstyled ps-3">
                                        <li>
                                            {foreach $ext_info as $ext_info_key => $ext_info_value}
                                                {$ext_info_key} : {$ext_info_value}<br />
                                            {/foreach}
                                        </li>
                                    </ul>
                                {/if}
                            {/foreach}
                        </li>
                    </ul>
                {/if}
            {/foreach}
        {/if}
    </div>
</div>
